# MASTER BRAIN MCP HUB - Environment Variables

# Brain connection
BRAIN_API_URL=http://localhost:3001
BRAIN_API_KEY=
BRAIN_TIMEOUT_MS=30000

# Auto-Memory
AUTO_MEMORY_ENABLED=true
AUTO_MEMORY_MIN_CONFIDENCE=0.7
AUTO_MEMORY_MODEL=claude-3-5-haiku-20241022

# Anthropic (required when Auto-Memory is enabled)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Persistence (optional)
# DATA_DIR=/var/lib/master-brain-mcp
# DEDUP_DB_PATH=/var/lib/master-brain-mcp/auto-memory-dedup.sqlite

NODE_ENV=production
LOG_LEVEL=info
